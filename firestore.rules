rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userDocPath()).data;
    }

    // Role from users/{uid}.role only — never from email domain.
    // exists() required so brand-new Auth users (no profile yet) do not
    // abort rule evaluation when isAdmin()/isDriver() are checked.
    function userRole() {
      return signedIn()
        && exists(userDocPath())
        && userDoc().keys().hasAny(['role'])
        ? userDoc().role
        : '';
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isDriver() {
      return signedIn() && userRole() == 'driver';
    }

    function isStudent() {
      return signedIn() && userRole() == 'student';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    function createRoleIsStudentOnly() {
      return request.resource.data.keys().hasAny(['role'])
        && request.resource.data.role == 'student';
    }

    // Drivers cannot reassign their own route/bus (Admin only).
    function driverAssignmentFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'assignedRouteId',
            'assignedBusId',
            'assignedRouteName',
            'assignedBusNumber',
            'assignedBusCode'
          ]);
    }

    // Students may join/cancel routes (assigned*), but cannot change
    // verificationStatus or escalate role.
    function studentStatusUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verificationStatus']);
    }

    // -------- users --------
    // Create: signed-in user may create ONLY their own doc as role=student
    // with verificationStatus pending|approved (registration). Admin may create
    // any role. Nobody can self-create as admin/driver.
    match /users/{userId} {
      allow read: if isAdmin()
        || isOwner(userId)
        || (signedIn()
            && resource.data.keys().hasAny(['email'])
            && resource.data.email == authEmail());

      allow create: if (isOwner(userId)
            && createRoleIsStudentOnly()
            && request.resource.data.keys().hasAny(['verificationStatus'])
            && request.resource.data.verificationStatus in ['pending', 'approved'])
        || isAdmin();

      allow update: if isAdmin()
        || (isOwner(userId)
            && roleUnchanged()
            && request.resource.data.role == 'student'
            && studentStatusUnchanged())
        || (isOwner(userId)
            && isDriver()
            && roleUnchanged()
            && driverAssignmentFieldsUnchanged());

      allow delete: if isAdmin();
    }

    // Duplicate-roll index used by registration (doc id = rollNoKey).
    // Signed-in users may get a single key; only Admin may list all.
    match /studentRollIndex/{rollKey} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.keys().hasAll(['uid', 'role'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'student');
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Limited public driver contact for students (name, phone, busNo, routeId, isOnDuty).
    match /driverPublic/{driverId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin()
        || (isDriver() && request.auth.uid == driverId);
    }

    match /duties/{dutyId} {
      allow read: if isAdmin()
        || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Legacy alerts collection kept for one-time migration read; no new writes
    // from the app. Admin may still read/delete; drivers no longer consume it.
    match /alerts/{alertId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /schedules/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Unified Notices (replaces Alerts). Missing audience/isActive treated as
    // all / active for legacy docs.
    function noticeAudience() {
      return resource.data.keys().hasAny(['audience'])
        ? resource.data.audience
        : (resource.data.keys().hasAny(['targetAudience'])
            ? resource.data.targetAudience
            : 'all');
    }

    function noticeIsActive() {
      return !resource.data.keys().hasAny(['isActive'])
        || resource.data.isActive == true;
    }

    function noticeReadableByCaller() {
      return noticeIsActive()
        && (noticeAudience() == 'all'
            || (noticeAudience() == 'drivers' && isDriver())
            || (noticeAudience() == 'students' && isStudent()));
    }

    match /notices/{id} {
      allow read: if isAdmin() || (signedIn() && noticeReadableByCaller());
      allow create, update, delete: if isAdmin();
    }

    match /buses/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /routes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Official university roster. Docs are keyed by rollNoKey.
    // Non-admins: get by id only (registration). Admin: full access.
    match /officialStudents/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Allowlist check by document id (= normalized email). No open list.
    match /approvedAdmins/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    function feedbackCreateValid() {
      return request.resource.data.keys().hasAll([
               'category', 'message', 'studentUid', 'status', 'createdAt'
             ])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.studentUid is string;
    }

    match /feedback/{id} {
      allow create: if signedIn() && feedbackCreateValid();
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Legacy Firestore GPS mirror (primary live tracking is RTDB).
    match /liveLocations/{driverId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (isDriver() && request.auth.uid == driverId);
      allow delete: if isAdmin();
    }

    match /_meta/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
